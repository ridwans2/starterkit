APP_NAME="Starter Kit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The version of YOUR system, shown in the panels' footer. Empty = the footer shows
# no version. It is the SEED: the value stored in /admin/configuracoes-da-aplicacao
# beats it at runtime. Do not confuse it with the kit version, which is an internal
# starter metric and lives in config/kit.php (`php artisan kit:info`).
APP_VERSION=

# Prefix of the containers and of the docker-compose.yml network. The kit:install command writes
# the name you chose here; no service has a fixed container_name.
COMPOSE_PROJECT_NAME=starter-kit

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite by default: create-project installs without depending on any external service.
# For Postgres via Docker, copy the variables from .env.docker over these.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=starter_kit
# DB_USERNAME=starter_kit
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# reverb turns real time on (the bell without polling) — it needs the Reverb container/process.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Model caching (mike-bronner) — Redis only; see .env.docker.
MODEL_CACHE_ENABLED=false
# MODEL_CACHE_STORE=model-cache

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Panel identity ----------------------------------------------------------
# Primary color of the three panels. The name of a color from the Filament palette: Amber,
# Blue, Cyan, Emerald, Fuchsia, Indigo, Lime, Orange, Pink, Purple, Red, Rose,
# Sky, Slate, Teal, Violet. Empty = Filament's own default.
# An organization's color (multi-tenancy) beats this one inside /app/{slug}.
KIT_COR_PRIMARIA=

# Free brand color, in hexadecimal (#rgb or #rrggbb). BEATS KIT_COR_PRIMARIA
# when both are filled in. A value outside the format is ignored and the color falls
# back to the list above, instead of taking the panel down.
KIT_COR_PRIMARIA_HEX=

# --- Defaults for every table in the project --------------------------------
# Editable in /admin/configuracoes-do-kit, which is the normal path. These keys
# are the seed and the fallback: the value stored in the database wins at runtime.
# Empty falls back to the default (never to 0/false) — see the block in config/kit.php.
# KIT_TABELA_PAGINACAO=10
# KIT_TABELA_LISTRADA=true
# KIT_TABELA_PERSISTIR_FILTROS=true
# KIT_TABELA_COLUNAS_REDIMENSIONAVEIS=true

# --- Unsaved-changes warning --------------------------------------------------
# When leaving a form with a pending change, the browser asks for confirmation
# before discarding it. Applies to the create and edit screens of the three panels.
# Seed and fallback of the editable key in /admin/configuracoes-da-aplicacao.
# KIT_ALERTA_ALTERACOES_NAO_SALVAS=true

# --- Layout density (the "compact" one) -------------------------------------
# confortavel (Filament's default), compacto or denso. Tightens at once the
# statistic cards, the tables, the sidebar menu and the buttons of the three
# panels — one --spacing declaration, no Vite theme and no npm run build.
# A value outside the vocabulary falls back to `confortavel`, which changes nothing.
# Seed and fallback of the editable key in /admin/configuracoes-da-aplicacao.
# KIT_DENSIDADE_DO_LAYOUT=confortavel

# --- Kit version in the footer ------------------------------------------------
# The SYSTEM version lives in APP_VERSION (the Laravel block, at the top). This key
# adds the STARTER KIT version next to it. Off: the kit's internal metric is not
# information about the delivered product. `php artisan kit:info` always shows it.
KIT_EXIBIR_VERSAO=false

# --- Size ceiling of every upload -------------------------------------------
# In MEGABYTES. Applies to the logo, the favicon and the login art
# (/admin/configuracoes-do-kit), the organization logo (/admin/organizacoes), the
# Project attachments and Livewire's temporary upload. Empty, 0 or missing = 10.
# Above 52 MB, also change docker/php/uploads.ini (upload_max_filesize and
# post_max_size) and docker/nginx/nginx.conf (client_max_body_size). Outside the kit's
# Docker, PHP usually ships with upload_max_filesize=2M, which becomes the real
# ceiling. SVG is refused in every field, regardless of size.
# KIT_UPLOAD_MAXIMO_MB=10

# Cache of the settings read from the database (spatie/laravel-settings). Off in the
# kit: with it on, saving through the screen requires `php artisan settings:clear-cache`.
# SETTINGS_CACHE_ENABLED=false

# --- Initial user -----------------------------------------------------------
# Created by UsuarioAdminSeeder with the master_global role, at install time.
# Change the password before exposing the environment.
# KIT_ADMIN_NAME=Administrador
KIT_ADMIN_EMAIL=admin@example.com
KIT_ADMIN_PASSWORD=password

# --- Multi-organization (multi-tenancy) -------------------------------------
# Turn it on with `php artisan kit:tenancy` — the command writes this key. Editing it by
# hand in an already migrated project leaves config and schema out of sync. At install time it
# is `kit:install` that turns it on, before the first migrate and without recreating the database.
KIT_TENANCY=false

# What the user calls each organization. The CODE keeps the Filament vocabulary
# (model Tenant, table tenants); only the label changes here.
# KIT_TENANCY_LABEL=Organização
# KIT_TENANCY_LABEL_PLURAL=Organizações
# KIT_TENANCY_SLUG=organizacoes

# Demonstration scenario (`php artisan kit:tenancy --demo`), which is exactly who writes
# this key. It is what makes the sample "Projetos" resource appear in /app —
# without it the business panel is born empty, as it should. Only valid with KIT_TENANCY=true.
KIT_DEMO=false

# Card navigation hub in the /admin and /app panels: a grid of cards with
# the panel's destinations, instead of the sidebar tree. Off because the
# starter kit doesn't need it. /infra has a hub independent of this key.
KIT_HUB=false

# Dynamic dashboard (mddev31/filament-dynamic-dashboard) as the entry screen of the
# panels. Off by default: the root answers the classic dashboard. Editable in
# /admin/configuracoes-da-aplicacao, Kit tab — the database beats the .env at runtime.
# KIT_DASHBOARD_DINAMICO_PAINEIS limits which panels it applies to (ids by comma);
# EMPTY means all of them. Turning it off preserves the dashboards already assembled.
KIT_DASHBOARD_DINAMICO=false
# KIT_DASHBOARD_DINAMICO_PAINEIS=

# Repository consulted by `php artisan kit:update` (`--repo=` wins). Empty
# falls back to the kit's official repository. Change it only to update from a fork.
# KIT_REPOSITORY=https://github.com/gsferro/filament-starter-kit-easy.git

# --- Open registration on /app -----------------------------------------------
# PUBLIC door that creates an account. With `false` (the default) /app/register only
# answers whoever brings a valid invitation token — the behavior that has always been.
# Whoever registers through here receives ONE role (panel_user) and nothing beyond it.
KIT_REGISTRO=false

# The sign-up is born pending and enters no panel until someone approves it on the
# users screen. With `false`, it enters right away.
KIT_REGISTRO_APROVACAO_MANUAL=false

# Requires a validated e-mail on /app: turns on the confirmation screen and the middleware.
# Applies to EVERY user of the panel, not only the new ones — whoever is missing
# email_verified_at is blocked. Whoever comes from an invitation is never affected.
KIT_REGISTRO_VERIFICAR_EMAIL=false

# --- Social login (laravel/socialite) --------------------------------------
# FOUR providers, each with its own switch, all OFF by default.
# Turning one on does not turn the others on, and turning one off does not take the others down.
#
# Turning it on here does NOT put the button live by itself: the three keys of that provider
# also need to be filled in — they are two conditions, because they fail for
# different reasons (a switch being off is a choice, an empty credential is
# carelessness). And this file only SEEDS: with the kit already installed, the
# `settings` table beats the .env on every request. Turn it on through the screen
# /admin/configuracoes-do-kit > Login, or `kit:install --force` (recreates the database). With one provider's switch off, the routes
# /auth/{provedor}/* answer 404 — and only its own: hiding the button is not enough,
# the URL is public.
#
# A provider OUTSIDE the list (facebook, discord, any other) answers 404 without
# even reaching the controller: the route parameter is typed as the enum
# App\Support\ProvedorSocial, and the white list is the enum itself.
#
# Social login AUTHENTICATES whoever already has an account with that e-mail, verified at the
# provider. It does NOT create an account while open registration is off,
# because the invitation remains the kit's only door in. It applies to all
# four.
#
# The coercion is FILTER_VALIDATE_BOOLEAN, so these switches fail
# CLOSED: `false`, `0`, `off`, `no`, empty and any unrecognizable value keep them
# off. Only `true` and `1` turn them on. Deliberately — they open
# public OAuth surface, and a security switch does not turn on by accident.
#
# Every *_CLIENT_SECRET is a SECRET: it goes to no log, no screen, no error
# message, no repository. Written by the
# /admin/configuracoes-do-kit screen, it stays ENCRYPTED in the database.
#
# The READMEs carry, provider by provider, where to create the OAuth app, which redirect URI to register
# and how the kit confirms that the e-mail is verified in each one — the answer differs
# across the four.

# Google — console.cloud.google.com > APIs & services > Credentials > OAuth client
# ID. Redirect: APP_URL + /auth/google/callback.
# Verification: the `email_verified` field of the payload.
KIT_SOCIALITE_GOOGLE=false
# Which panels each provider applies to, separated by comma: admin,app,infra
# EMPTY = ALL panels, which is the behavior that has always been. It serves to release
# corporate Google on /admin only, for example. Also editable on
# /admin/configuracoes-do-kit, on the Login tab.
KIT_SOCIALITE_GOOGLE_PAINEIS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub — github.com/settings/developers > OAuth Apps > New OAuth App.
# Redirect: APP_URL + /auth/github/callback.
# Verification: Socialite queries /user/emails and OVERWRITES the e-mail with the
# primary + verified entry — or with nothing, if it fails. So a filled-in e-mail already
# means verified, and an empty one falls into the refusal by email_ausente. This depends
# on the `user:email` scope, which is the driver's default: adding scopes in the
# config is safe (they ADD UP), removing that one is not. There is a test case guarding it.
KIT_SOCIALITE_GITHUB=false
KIT_SOCIALITE_GITHUB_PAINEIS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn — linkedin.com/developers > Create app > Products, and ENABLE the
# "Sign In with LinkedIn using OpenID Connect" product. The driver is
# `linkedin-openid` (not the legacy `linkedin`, which reports no verification
# at all and whose scopes LinkedIn discontinued).
# Redirect: APP_URL + /auth/linkedin-openid/callback.
# Verification: the `email_verified` field of the OpenID userinfo.
KIT_SOCIALITE_LINKEDIN=false
KIT_SOCIALITE_LINKEDIN_PAINEIS=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X (former Twitter) — developer.x.com > Projects & Apps > User authentication
# settings, Web App type with OAuth 2.0 and the users.read and users.email scopes.
# Redirect: APP_URL + /auth/x/callback.
# Verification: X only returns `confirmed_email`, that is, an address it already
# confirmed — the PRESENCE of the e-mail is the proof. Without the users.email scope it returns
# no e-mail, and the kit refuses with the `email_ausente` reason.
KIT_SOCIALITE_X=false
KIT_SOCIALITE_X_PAINEIS=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Binding with the provider. Whoever enters through a provider gets BOUND to it
# (vinculos_sociais table): on later entries the account is recognized by the
# identity at the provider, not by the e-mail. On the FIRST social entry into an
# account that already exists, the kit binds by the verified e-mail and WARNS the person
# by e-mail (false, default) — or requires that they CONFIRM through the link in the e-mail
# before entering (true). Also on the /admin/configuracoes-do-kit > Login screen.
KIT_SOCIALITE_VINCULO_CONFIRMAR=false

# --- Bot protection on the public screens -----------------------------------
# A "not a robot" challenge on the THREE public screens with a form
# — login, "forgot password?" and registration — of the three panels. OFF by
# default, like each social provider, and by the same two-condition rule:
# turning the switch on without the two keys filled in does NOT turn anything on (it would enable a
# required field impossible to fill, locking everyone out of login).
#
# Who renders the widget and verifies the token is the `ddr/filament-captcha` package;
# the provider is the name of its driver. A value outside the list = off, with
# a warning in the `autenticacao` log.
#   recaptcha_v2 → google.com/recaptcha/admin (type "Challenge (v2)", checkbox)
#   recaptcha_v3 → google.com/recaptcha/admin (type "Score (v3)", invisible)
#   turnstile    → dash.cloudflare.com → Turnstile → Add widget (Managed mode)
#   hcaptcha     → dashboard.hcaptcha.com → Sites → New
# The package's OWN env vars (CAPTCHA_DRIVER, RECAPTCHA_V2_SITEKEY, ...)
# are ignored: the configuration is only this one and the screen.
#
# The SECRET key is a SECRET: it goes to no log, screen nor repository; written
# by the /admin/configuracoes-do-kit screen, it stays ENCRYPTED in the database. The site
# key is public by nature (it goes into the HTML). If the provider goes down, the kit REFUSES the
# submission (fail closed) — turn it off here or on the screen to go back to normal.
#
# PONTUACAO_MINIMA only applies to reCAPTCHA v3: a score (0 = robot, 1 =
# person) below it refuses the submission. 0.5 is what Google suggests.
#
# LOCAL: with APP_ENV=local the challenge stays OFF by default — a production
# key does not accept localhost and the required field would be unfillable.
# Turn it on (true) to see the widget locally, with keys that accept localhost.
# Also on the /admin/configuracoes-do-kit > Login > Bot protection screen.
KIT_ANTI_ROBO=false
KIT_ANTI_ROBO_LOCAL=false
KIT_ANTI_ROBO_PROVEDOR=recaptcha_v3
KIT_ANTI_ROBO_CHAVE_DO_SITE=
KIT_ANTI_ROBO_CHAVE_SECRETA=
KIT_ANTI_ROBO_PONTUACAO_MINIMA=0.5

# Facebook and Discord have NO key here, and the absence is a recorded decision:
# Facebook exposes no verified-e-mail signal in either of its two
# paths, and Discord is not a Socialite driver (it would come from a community
# package, that is, a new dependency). The READMEs say what would be missing
# to include each one, and ADR-04 and ADR-05 of
# wikis/specs/feat/mais-provedores-sociais/ say why we did not include them.

# Footer of the login screen of the three panels. Empty (or spaces only) = no footer.
# TEXT, not HTML: the login screen is public and unauthenticated, and the value comes out
# escaped. A link in the footer would require a structured field, not loose HTML.
KIT_LOGIN_RODAPE=

# Single login page at /login for the three panels. Off (default),
# each panel has its own screen. On, /admin/login, /infra/login and
# /app/login lead to /login; whoever has access to more than one panel chooses after
# entering, whoever has only one enters directly. Only `true`/`1` turn it on. It stands as the
# INITIAL value: after installation, the settings screen (Login tab) is who decides.
KIT_LOGIN_UNIFICADO=false

# --- User invitation -------------------------------------------------------
# Days between sending the invitation and the link expiring. Sending requires
# a real MAIL_MAILER (the default `log` only writes into storage/logs) and a
# queue worker running, because the notification is queueable.
# Leaving this EMPTY or 0 turns nothing off: it falls into the 7-day default. An invitation
# of zero days would be born expired, and config/kit.php handles that on purpose.
KIT_CONVITE_VALIDADE_DIAS=7

# Maximum number of addresses per batch in "Bulk invite". With QUEUE_CONNECTION=sync
# each e-mail is an SMTP handshake inside the request, and a hundred of them brush against
# max_execution_time. Raising this requires a queue worker running.
# Empty or 0 here does not turn the limit off: it falls into the default of 100.
KIT_CONVITE_LIMITE_LOTE=100

# Days, counted from sending, in which each reminder of the pending invitation is due. The
# reminder sends a SECOND link, in parallel: the e-mail the person already has keeps
# working. Empty turns it off. Every day must be SMALLER than KIT_CONVITE_VALIDADE_DIAS,
# otherwise the invitation expires first and no reminder goes out. Requires an active scheduler (it is
# `kit:convites-lembrar`, scheduled in routes/console.php) and a queue worker.
KIT_CONVITE_LEMBRETES_DIAS=3,5

# --- Retention of the /infra trails ---------------------------------------
# How long the kit keeps what it RECORDS. Not a matter of taste: the two tables
# grow per event and hold sensitive data — a stack trace may contain
# request parameters, and the body of the invitation e-mail carries the acceptance link.
# 14 days follows the `days` of log rotation.
#
# Who applies it is the scheduler (routes/console.php). Without `schedule:work` or the
# compose `scheduler` service, the number here is only a declared intention.
# Zero or negative turns pruning off — and then the table grows without a ceiling.
KIT_RETENCAO_EXCECOES_DIAS=14
KIT_RETENCAO_EMAILS_DIAS=14
KIT_RETENCAO_IMPORTACOES_DIAS=30
KIT_RETENCAO_EXPORTACOES_DIAS=30

# URL root: the kit shortens the address when the server delivers a base
# ending in /public — symptom of a DocumentRoot pointing at the project root
# instead of public/.
#
# Empty = DETECTS (looks for a RewriteRule to public/ in the root .htaccess and
# only shortens if it finds one). Leave it like this, except on nginx: there is no .htaccess to
# inspect there, and the rewrite lives in the vhost — declare true.
#   true  = always shorten
#   false = never shorten
KIT_URL_REMOVER_SUFIXO_PUBLIC=

# --- Media (spatie/laravel-medialibrary) ----------------------------------
# `public` is the package's default and serves for avatar and logo, which are identity
# images. It does NOT serve for a document: the path is /storage/{id}/{arquivo}
# with a sequential ID, reachable WITHOUT A SESSION and without a tenant — Filament's multi-organization
# does not reach the filesystem.
#
# For an attachment that is not a public image, switch to a private disk and serve it
# through an authorized route. See config/media-library.php and wikis/pacotes.md.
MEDIA_DISK=local

# --- Panel security -----------------------------------------------
LOCKSCREEN_ENABLED=true
LOCKSCREEN_IDLE_TIMEOUT=1800
NEW_DEVICE_NOTIFICATION=false
COMMAND_CENTER_ENABLED=true
ONBOARDING_ENABLED=true

# --- AI (laravel/ai + fomvasss ledger) -------------------------------------
# Local by default (docker compose --profile ai up -d). For SaaS, change
# AI_PROVIDER (openai|anthropic|gemini...) and set the matching API key.
AI_PROVIDER=llamacpp
# AI_AGENT_TIMEOUT=180
LLAMACPP_URL=http://localhost:8080/v1
LLAMACPP_MODEL=qwen2.5-7b-instruct
LLAMACPP_EMBED_URL=http://localhost:8081/v1
LLAMACPP_EMBED_MODEL=qwen3-embedding-0.6b
# OLLAMA_URL=http://localhost:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Execution ledger (ai_runs) — never stores the prompt by default (LGPD).
AI_STORE_REQUEST=false
# AI_BUDGET_MENSAL_DEFAULT=100

# --- Real time (Reverb) — see the full block in .env.docker -----------------
REVERB_APP_ID=starter-kit
REVERB_APP_KEY=starter-kit-key
REVERB_APP_SECRET=starter-kit-secret
REVERB_HOST=localhost
REVERB_PORT=8090
REVERB_SCHEME=http
REVERB_SERVER_PORT=8090
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
