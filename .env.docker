# =============================================================================
# Copy/adjust these variables in your .env when using the Docker stacks.
# The kit installs with SQLite + queues/cache on database — this file is the "upgrade".
# =============================================================================

APP_URL=http://localhost:8000

# --- Database (pgsql container) ----------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=starter_kit
DB_USERNAME=starter_kit
DB_PASSWORD=secret

# --- Database (mysql container) -----------------------------------------------
# Alternative to the block above — one OR the other. Comes up with `docker compose up -d mysql redis`.
# The host port has its own key (FORWARD_MYSQL_PORT, default 3306).
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=starter_kit
# DB_USERNAME=root
# DB_PASSWORD=secret

# --- Cache (redis container — cache only; queues stay on database) -----------
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Model caching (mike-bronner/laravel-model-caching) — only makes sense with Redis.
MODEL_CACHE_ENABLED=true
MODEL_CACHE_STORE=model-cache

# --- Queues ------------------------------------------------------------------
QUEUE_CONNECTION=database

# --- E-mail (profile: mail → Mailpit on 1025/8025) ----------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=hello@example.com

# --- Local AI (profile: ai → llama.cpp) ---------------------------------------
AI_PROVIDER=llamacpp
LLAMACPP_URL=http://localhost:8080/v1
LLAMACPP_MODEL=qwen2.5-7b-instruct
LLAMACPP_EMBED_URL=http://localhost:8081/v1
LLAMACPP_EMBED_MODEL=qwen3-embedding-0.6b

# --- Containerized application (profile: app) ---------------------------------
# Database the `app` profile uses from inside the network. Turn on the database profile too:
# `docker compose --profile app --profile mysql up -d --build`.
# DOCKER_DB_SERVICE=mysql

# --- Real time (profiles: app/realtime → Reverb on 8090) ---------------------
# Three pairs with distinct roles:
#   REVERB_*       = where PHP sends the broadcast
#   VITE_REVERB_*  = where the BROWSER connects (never a Docker service name)
#   REVERB_SERVER_PORT = where the reverb:start process listens
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=starter-kit
REVERB_APP_KEY=starter-kit-key
REVERB_APP_SECRET=starter-kit-secret
REVERB_HOST=localhost
REVERB_PORT=8090
REVERB_SCHEME=http
REVERB_SERVER_PORT=8090
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8090
VITE_REVERB_SCHEME=http
